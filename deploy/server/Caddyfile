{
	admin off
	# Certificates for *.ts.net come from the local tailscaled (socket mounted).
}

{$SERVER_HOSTNAME} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	@backend path /api/* /email-verification
	handle @backend {
		# Caddy ignores client-sent X-Forwarded-For and sets exactly one value,
		# matching the backend's single-hop TRUSTED_PROXY_IP policy.
		reverse_proxy 172.30.10.20:8000
	}

	handle {
		# The panel loads only its own files (no inline scripts or styles, fonts self-hosted).
		# Kept off the backend routes: /email-verification sends its own nonce-based policy.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		header Permissions-Policy "camera=(), microphone=(), geolocation=()"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
