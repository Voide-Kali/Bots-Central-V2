{
	admin off
	# Certificates for *.ts.net come from the local tailscaled (socket mounted).
	# Public exposure (ADR-030): behind Tailscale Funnel the real client IP arrives via
	# X-Forwarded-For from the local funnel proxy (a private/loopback source), so trust private
	# ranges. Direct tailnet clients come from 100.64.0.0/10 (NOT a private range here), so their
	# client-sent X-Forwarded-For is still ignored, as before.
	servers {
		trusted_proxies static private_ranges
	}
}

# Shared routing for the tailnet HTTPS listener and the Funnel HTTP listener.
(site) {
	encode zstd gzip
	# Access log with the resolved real client IP (client_ip), for optional fail2ban (ADR-030).
	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 5
		}
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	@backend path /api/* /email-verification
	handle @backend {
		# Send exactly one X-Forwarded-For: the resolved real client IP (respects trusted_proxies).
		# Keeps the backend's single-hop TRUSTED_PROXY_IP policy, now with the real IP under Funnel,
		# so its per-IP abuse control throttles real attackers instead of one shared proxy address.
		reverse_proxy 172.30.10.20:8000 {
			header_up X-Forwarded-For {http.request.client_ip}
		}
	}

	# Download site (ADR-026/029): installers + landing, mounted read-only at /srv/baixar.
	redir /baixar /baixar/
	handle_path /baixar/* {
		header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		header Permissions-Policy "camera=(), microphone=(), geolocation=()"
		root * /srv/baixar
		file_server
	}

	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		header Permissions-Policy "camera=(), microphone=(), geolocation=()"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Private tailnet entrance (HTTPS with the *.ts.net certificate). Always on.
{$SERVER_HOSTNAME} {
	import site
}

# Public entrance for Tailscale Funnel (ADR-030). Funnel terminates TLS and forwards plain HTTP
# here; this listener is reachable only through the 127.0.0.1 port published in compose, i.e. via
# the Funnel. Serving plain HTTP (no redirect) avoids an HTTPS redirect loop through the Funnel.
:8080 {
	import site
}
