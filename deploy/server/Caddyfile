{
	admin off
	# Certificates for *.ts.net come from the local tailscaled (socket mounted).
}

# Shared routing for the tailnet HTTPS listener and the Funnel HTTP listener.
(site) {
	encode zstd gzip
	# Access log with the resolved real client IP (client_ip), for optional fail2ban (ADR-030).
	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 5
		}
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	@backend path /api/* /email-verification
	handle @backend {
		# Caddy ignores client-sent X-Forwarded-For and sets exactly one value (the immediate peer),
		# matching the backend's single-hop TRUSTED_PROXY_IP policy. Do NOT add `trusted_proxies`
		# or `header_up X-Forwarded-For` here: that made Caddy trust the Funnel's injected XFF and
		# the backend's strict single-IP parser then rejected it, so every login and heartbeat 503'd
		# (regression from ADR-030, reverted). Under the Funnel the client appears as the funnel
		# proxy, so per-IP abuse control is coarse there; the per-account throttle still applies.
		reverse_proxy 172.30.10.20:8000
	}

	# Bare-path tidy-ups (ADR-034): the panel needs its trailing slash; the old /baixar PAGE moved
	# to the root, so a visit to /baixar now goes home (the installer FILES stay under /baixar/).
	redir /painel /painel/
	redir /baixar /

	# Panel (ADR-034): the React SPA now lives under /painel. The image bakes its dist at /srv/painel
	# and Vite builds assets with base "/painel/", so /painel/assets/* resolve here. Strict CSP (the
	# app runs its own scripts). Keep this CSP in sync with the panel's needs.
	handle /painel/* {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		header Permissions-Policy "camera=(), microphone=(), geolocation=()"
		root * /srv
		try_files {path} /painel/index.html
		file_server
	}

	# Installer files only (ADR-026/034): the .deb/.command and their .sha256, generated by
	# build-downloads.sh into downloads/baixar and mounted read-only at /srv/site/baixar.
	handle_path /baixar/* {
		header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		header Permissions-Policy "camera=(), microphone=(), geolocation=()"
		root * /srv/site/baixar
		file_server
	}

	# Public site at the ROOT (ADR-029/034): the landing ("Nada acontece sem o seu aval"), the
	# privacy/terms pages and their assets, mounted read-only at /srv/site. This is the first thing a
	# visitor sees — not the panel. Inline <style> on these pages needs style-src 'unsafe-inline'.
	handle {
		header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		header Permissions-Policy "camera=(), microphone=(), geolocation=()"
		root * /srv/site
		try_files {path} /index.html
		file_server
	}
}

# Single entrance (ADR-031): plain HTTP on :8080, reachable only via the 127.0.0.1:8082 port in
# compose. Tailscale `serve`/`funnel` owns :443 on the tailnet address, terminates TLS, and forwards
# BOTH tailnet and public traffic here. The web no longer binds the tailnet :443 itself (that
# collided with the Funnel on :443). Serving plain HTTP (no auto-HTTPS, no redirect) avoids a TLS
# loop through the Funnel. Start it with: sudo tailscale funnel --bg --https=443 http://127.0.0.1:8082
:8080 {
	import site
}
