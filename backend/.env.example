# Local-development example only. Do not use these placeholder values in production.
# Pydantic reads this file as backend/.env; Compose reads the repository-root .env.
APP_ENV=development
APP_NAME=Bots Central V2
DATABASE_URL=postgresql+psycopg://bots_central:change-me-for-local-development@localhost:5432/bots_central
LOG_LEVEL=INFO

# Health-only development can stop here. A functional local registration/login flow
# also needs a reachable SMTP service and unique generated HMAC keys; see
# docs/CONFIGURATION.md and docs/LOCAL_E2E.md. Never commit real values.
# PUBLIC_ORIGIN=http://127.0.0.1:8080
# TRUSTED_PROXY_IP=127.0.0.1
# ABUSE_CONTROL_HMAC_KEY=<base64url-random-32-byte-or-longer-secret>
# EMAIL_VERIFICATION_DELIVERY_MODE=smtp
# EMAIL_VERIFICATION_MATERIAL_TYPE=link
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SENDER=verification@localhost
# SMTP_TIMEOUT_SECONDS=10
# SMTP_CA_FILE=/absolute/path/to/internal-smtp-ca.pem
# EMAIL_VERIFICATION_HMAC_ACTIVE_KEY_VERSION=current
# EMAIL_VERIFICATION_HMAC_KEYS={"current":"<base64url-random-32-byte-or-longer-secret>"}
# ARGON2_MAX_CONCURRENCY=2
