# Development-only examples. Never use these values outside a local environment.
APP_ENV=development
APP_NAME=Bots Central V2
POSTGRES_DB=bots_central
POSTGRES_USER=bots_central
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://bots_central:change-me-for-local-development@localhost:5432/bots_central
LOG_LEVEL=INFO
# Telegram bot (ADR-011). Create it with @BotFather; never commit the real token.
# Start with: docker compose --profile telegram up -d
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 32+ random bytes, base64url, e.g.: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ABUSE_CONTROL_HMAC_KEY=
